# Projeto Supabase DO PAINEL (não dos clientes)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key
# Chave secreta (service_role / sb_secret_...) — usada SÓ pelo cron no servidor
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Segredo do cron (a Vercel envia como "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=gere-uma-string-aleatoria-longa

# E-mails que podem entrar no painel (separados por vírgula)
ALLOWED_EMAILS=voce@exemplo.com
